# Packages directory (contains decompiled source and large binaries)
packages/

# Tasks directory (contains ClickUp task data and analysis results)
tasks/*
!tasks/.gitkeep

# Environment variables (contains API keys)
.env

# Temporary files
_incoming/
*.tmp
*.log

# OS generated files
Thumbs.db
.DS_Store

# Claude Code session files (ignore all except agents)
.claude/*
!.claude/agents/
**/.claude/settings.local.json

# IDE files
.idea/
.vscode/
*.suo
*.user

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
build/
.venv/

# Node.js
node_modules/
web/frontend/dist/

# Logs
logs/

# Windows artifacts
nul
