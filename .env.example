# ClickUp API
# Get your API key from: https://app.clickup.com/settings/apps
CLICKUP_API_KEY=pk_your_clickup_api_key_here

# ClickUp User ID (assignee 매칭용)
# 확인 방법: ClickUp Settings > Apps 페이지에서 확인
CLICKUP_USER_ID=

# Docker deployment overrides (optional)
# ISSUEBOT_ROOT=/app
# ISSUEBOT_TASKS_DIR=/app/tasks
# ISSUEBOT_PACKAGES_DIR=/app/packages
# ISSUEBOT_LOGS_DIR=/app/logs
